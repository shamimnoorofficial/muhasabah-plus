{
  "id": "/",
  "name": "Muhasabah Plus",
  "short_name": "Muhasabah",
  "description": "Muhasabah Plus is an Islamic habit tracker: build daily habits, earn points, write a private journal and track your progress. Works offline and keeps your data on your device.",
  "lang": "en",
  "dir": "ltr",
  "start_url": "/?source=pwa",
  "scope": "/",
  "display": "standalone",
  "display_override": [
    "standalone",
    "minimal-ui",
    "browser"
  ],
  "orientation": "portrait",
  "background_color": "#0a0d14",
  "theme_color": "#0a0d14",
  "categories": [
    "lifestyle",
    "productivity",
    "education"
  ],
  "icons": [
    {
      "src": "/icons/icon-48.png",
      "sizes": "48x48",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-72.png",
      "sizes": "72x72",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-96.png",
      "sizes": "96x96",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-128.png",
      "sizes": "128x128",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-144.png",
      "sizes": "144x144",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-256.png",
      "sizes": "256x256",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-384.png",
      "sizes": "384x384",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/maskable-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/icons/maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "screenshots": [
    {
      "src": "/screenshots/today-narrow.webp",
      "sizes": "1082x2402",
      "type": "image/webp",
      "form_factor": "narrow",
      "label": "Today's checklist with habits to complete"
    },
    {
      "src": "/screenshots/habits-narrow.webp",
      "sizes": "1082x2402",
      "type": "image/webp",
      "form_factor": "narrow",
      "label": "Habit control panel with points and repeat days"
    },
    {
      "src": "/screenshots/dashboard-narrow.webp",
      "sizes": "1082x2402",
      "type": "image/webp",
      "form_factor": "narrow",
      "label": "Dashboard with point balance and streak"
    },
    {
      "src": "/screenshots/dashboard-wide.webp",
      "sizes": "1280x800",
      "type": "image/webp",
      "form_factor": "wide",
      "label": "Dashboard with point flow chart on desktop"
    },
    {
      "src": "/screenshots/today-wide.webp",
      "sizes": "1280x800",
      "type": "image/webp",
      "form_factor": "wide",
      "label": "Today's checklist on desktop"
    },
    {
      "src": "/screenshots/habits-wide.webp",
      "sizes": "1280x800",
      "type": "image/webp",
      "form_factor": "wide",
      "label": "Habits on desktop"
    }
  ],
  "shortcuts": [
    {
      "name": "Today's checklist",
      "short_name": "Today",
      "description": "Open today's habits and todos",
      "url": "/?tab=today&source=shortcut",
      "icons": [
        {
          "src": "/icons/shortcut.png",
          "sizes": "96x96",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Habits",
      "short_name": "Habits",
      "description": "Create and manage your habits",
      "url": "/?tab=habits&source=shortcut",
      "icons": [
        {
          "src": "/icons/shortcut.png",
          "sizes": "96x96",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Dashboard",
      "short_name": "Dashboard",
      "description": "See your point balance and streak",
      "url": "/?tab=dashboard&source=shortcut",
      "icons": [
        {
          "src": "/icons/shortcut.png",
          "sizes": "96x96",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Backup",
      "short_name": "Backup",
      "description": "Back up or restore your data",
      "url": "/?tab=settings&source=shortcut",
      "icons": [
        {
          "src": "/icons/shortcut.png",
          "sizes": "96x96",
          "type": "image/png"
        }
      ]
    }
  ],
  "related_applications": [
    {
      "platform": "play",
      "url": "https://play.google.com/store/apps/details?id=com.shamimnoor.muhasabahplus",
      "id": "com.shamimnoor.muhasabahplus"
    },
    {
      "platform": "webapp",
      "url": "https://muhasabah-plus.app/manifest.webmanifest"
    }
  ],
  "prefer_related_applications": false,
  "share_target": {
    "action": "/share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "backup",
          "accept": [
            "application/json",
            ".json",
            "text/plain",
            ".txt"
          ]
        }
      ]
    }
  },
  "file_handlers": [
    {
      "action": "/?source=file",
      "accept": {
        "application/json": [
          ".json"
        ],
        "text/plain": [
          ".txt"
        ]
      },
      "icons": [
        {
          "src": "/icons/icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ],
      "launch_type": "single-client"
    }
  ],
  "protocol_handlers": [
    {
      "protocol": "web+muhasabah",
      "url": "/?protocol=%s"
    }
  ],
  "edge_side_panel": {
    "preferred_width": 420
  },
  "launch_handler": {
    "client_mode": [
      "navigate-existing",
      "auto"
    ]
  },
  "handle_links": "preferred"
}
