{
  "id": "/",
  "name": "Muhasabah — Habit Tracker",
  "short_name": "Muhasabah",
  "description": "Islamic habit tracker. Works offline. Data stays on your device.",
  "start_url": "/?source=pwa",
  "scope": "/",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#0a0d14",
  "theme_color": "#0a0d14",
  "categories": [
    "lifestyle",
    "productivity"
  ],
  "icons": [
    {
      "src": "/icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/maskable-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/icons/maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Today's checklist",
      "short_name": "Today",
      "url": "/?tab=today&source=shortcut",
      "icons": [
        {
          "src": "/icons/shortcut.png",
          "sizes": "96x96",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Habits",
      "short_name": "Habits",
      "url": "/?tab=habits&source=shortcut",
      "icons": [
        {
          "src": "/icons/shortcut.png",
          "sizes": "96x96",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Backup",
      "short_name": "Backup",
      "url": "/?tab=settings&source=shortcut",
      "icons": [
        {
          "src": "/icons/shortcut.png",
          "sizes": "96x96",
          "type": "image/png"
        }
      ]
    }
  ],
  "related_applications": [
    {
      "platform": "webapp",
      "url": "https://muhasabah-pro.netlify.app/manifest.webmanifest"
    }
  ],
  "prefer_related_applications": false
}
